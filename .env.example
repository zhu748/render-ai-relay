# Required. Use the origin, without /v1, when your client already sends /v1/...
TARGET_URL=https://your-ai-site.example
PORT=10000

# First heartbeat after 1 second. Set to 0 for an immediate first heartbeat.
HEARTBEAT_START_DELAY_SECONDS=1
HEARTBEAT_INTERVAL_SECONDS=1
# early | after-headers | off. Route rules use longest matching prefix.
HEARTBEAT_MODE=early
HEARTBEAT_ROUTES=[]

# Optional deployment keepalive (separate from in-request whitespace heartbeats).
# Use a lightweight URL, e.g. https://your-service.onrender.com/keepalive.
# Empty URL disables the task. Non-empty values lock the corresponding admin UI field.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=60
KEEPALIVE_TIMEOUT_SECONDS=30
# Admin UI changes only last until this process stops; env values survive redeploys.

# Total upstream request limit, independent of heartbeats. 0 means no total cap.
UPSTREAM_TIMEOUT_SECONDS=1800
CONNECT_TIMEOUT_SECONDS=30
# TCP probes help detect dead peers; they do not extend HTTP/CDN deadlines.
TCP_KEEPALIVE_SECONDS=15
# Expire only idle pooled upstream sockets; active AI calls are unaffected.
UPSTREAM_IDLE_SOCKET_TIMEOUT_SECONDS=15
# Maximum continuous wait for downstream drain. 0 disables this guard.
DOWNSTREAM_STALL_TIMEOUT_SECONDS=120
# Platform termination deadlines still apply; Render normally needs a margin.
SHUTDOWN_GRACE_SECONDS=25

# Raw request bodies are buffered without modification. JSON responses use temp files.
MAX_REQUEST_BYTES=33554432
MAX_JSON_RESPONSE_BYTES=268435456
# Validate JSON incrementally without changing its bytes; bound container nesting.
MAX_JSON_DEPTH=1024
MAX_CONCURRENT_REQUESTS=32
MAX_BUFFERED_REQUEST_BYTES=67108864
# Combined JSON response temp-file budget for this process (512 MiB).
MAX_BUFFERED_RESPONSE_BYTES=536870912
# Buffer incomplete SSE events so heartbeats can continue safely.
MAX_SSE_EVENT_BYTES=16777216
MAX_BUFFERED_SSE_BYTES=67108864
# Optional. Defaults to render-ai-relay under the system temporary directory.
TEMP_DIRECTORY=
# Keep at least 16 MiB free before starting a JSON response temp file.
TEMP_MIN_FREE_BYTES=16777216
# Retry failed cleanup in the background; budget releases only after deletion.
TEMP_CLEANUP_RETRY_SECONDS=5
# Bound failed-cleanup directories as well as their logical response bytes.
MAX_PENDING_TEMP_CLEANUPS=64

# Empty means all paths. Example: /v1/,/api/
HEARTBEAT_PATH_PREFIXES=

# Optional independent relay authentication. Client sends X-Proxy-Token.
# Authorization / x-api-key are still forwarded to your target unchanged.
PROXY_TOKEN=

# Diagnostics: open /__proxy/ and enter this separate management token.
# Blank disables access to request logs and heartbeat probes (page still loads).
# Render Blueprint generates a value; existing services must add this variable.
ADMIN_TOKEN=
# Optional dedicated management Host values, comma-separated, without scheme.
# Include :port for non-default ports. These hosts never serve upstream pages.
ADMIN_HOSTS=
# Registration is blocked by default. With ADMIN_TOKEN, opt-in requires ADMIN_HOSTS.
ALLOW_UPSTREAM_SERVICE_WORKERS=false
# Optional exact browser origins for relay API CORS; management stays same-origin.
# No wildcard and no cross-origin cookie credentials.
CORS_ORIGINS=
# Independent deadline for uploading admin settings (1-120 seconds; max 2 uploads).
ADMIN_REQUEST_TIMEOUT_SECONDS=15
