# Required. Use the origin, without /v1, when your client already sends /v1/...
TARGET_URL=https://your-ai-site.example
PORT=10000

# First heartbeat after 1 second. Set to 0 for an immediate first heartbeat.
HEARTBEAT_START_DELAY_SECONDS=1
HEARTBEAT_INTERVAL_SECONDS=1

# Total upstream request limit, independent of heartbeats. 0 means no total cap.
UPSTREAM_TIMEOUT_SECONDS=1800
CONNECT_TIMEOUT_SECONDS=30

# Raw request bodies are buffered without modification. JSON responses use temp files.
MAX_REQUEST_BYTES=33554432
MAX_JSON_RESPONSE_BYTES=268435456
MAX_CONCURRENT_REQUESTS=32
MAX_BUFFERED_REQUEST_BYTES=67108864
# Optional. Defaults to render-ai-relay under the system temporary directory.
TEMP_DIRECTORY=

# Empty means all paths. Example: /v1/,/api/
HEARTBEAT_PATH_PREFIXES=

# Optional independent relay authentication. Client sends X-Proxy-Token.
# Authorization / x-api-key are still forwarded to your target unchanged.
PROXY_TOKEN=
